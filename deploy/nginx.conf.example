server {
    listen 80;
    server_name itmmultimedia.rs www.itmmultimedia.rs;
    return 301 https://itmmultimedia.rs$request_uri;
}

server {
    listen 443 ssl http2;
    server_name www.itmmultimedia.rs;
    ssl_certificate /etc/letsencrypt/live/itmmultimedia.rs/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/itmmultimedia.rs/privkey.pem;
    return 301 https://itmmultimedia.rs$request_uri;
}

server {
    listen 443 ssl http2;
    server_name itmmultimedia.rs;

    ssl_certificate /etc/letsencrypt/live/itmmultimedia.rs/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/itmmultimedia.rs/privkey.pem;

    client_max_body_size 20M;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
